---
import { url, loja, enderecoCompleto, horarioLegivel, rotaGoogle, whatsapp } from "../lib/site";
import { servicos } from "../data/servicos";
---

<footer class="relative mt-24 bg-azul-900 text-azul-100">
  <svg class="absolute -top-px left-0 w-full -translate-y-full text-azul-900" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M0 60V30C240 0 480 0 720 22s480 30 720 0v38z" />
  </svg>
  <div class="container-site grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl font-semibold text-white">Lambeijos <span class="text-lingua-400">♥</span></p>
      <p class="mt-3 leading-relaxed">Pet shop no bairro Castelo, em Belo Horizonte. Banho e tosa, veterinário, rações e farmácia pet há mais de 10 anos.</p>
      <div class="mt-5 flex gap-3">
        <a href={loja.instagram} class="grid size-11 place-items-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="Instagram do Lambeijos" rel="noopener">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.2.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"/></svg>
        </a>
        <a href={whatsapp("Olá! Vim pelo site do Lambeijos.")} class="grid size-11 place-items-center rounded-full bg-white/10 transition hover:bg-white/20" aria-label="WhatsApp do Lambeijos" rel="noopener">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8zm8.4-18.2A11.8 11.8 0 0 0 1.7 17.8L0 24l6.3-1.7a11.8 11.8 0 0 0 5.7 1.4A11.8 11.8 0 0 0 20.4 3.6z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <p class="font-display text-lg font-semibold text-white">Serviços</p>
      <ul class="mt-3 space-y-2">
        {servicos.map((s) => <li><a href={url(`/${s.slug}/`)} class="hover:text-white hover:underline">{s.nome}</a></li>)}
        <li><a href={loja.lojaVirtual} class="hover:text-white hover:underline" rel="noopener">Loja virtual</a></li>
        <li><a href={url("/bairros-atendidos/")} class="hover:text-white hover:underline">Bairros atendidos</a></li>
      </ul>
    </div>

    <div>
      <p class="font-display text-lg font-semibold text-white">Horário</p>
      <dl class="mt-3 space-y-2">
        {horarioLegivel.map((h) => (
          <div class="flex justify-between gap-4 border-b border-white/10 pb-2"><dt>{h.dias}</dt><dd class="font-semibold text-white">{h.horas}</dd></div>
        ))}
      </dl>
    </div>

    <div>
      <p class="font-display text-lg font-semibold text-white">Onde estamos</p>
      <address class="mt-3 not-italic leading-relaxed">
        {loja.endereco.rua}<br />{loja.endereco.bairro}, {loja.endereco.cidade} - {loja.endereco.uf}<br />CEP {loja.endereco.cep}
      </address>
      <p class="mt-3"><a href={`tel:${loja.telefone}`} class="font-semibold text-white hover:underline">{loja.telefoneExibicao}</a></p>
      <a href={rotaGoogle} class="mt-3 inline-block font-semibold text-azul-200 hover:text-white hover:underline" rel="noopener" title={enderecoCompleto}>Traçar rota →</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-site py-6 text-sm text-azul-200">© {new Date().getFullYear()} Pet Shop Lambeijos · Belo Horizonte, MG</p>
  </div>
</footer>
