---
import { loja } from "../lib/site";

const { nota, total, distribuicao, destaques } = loja.avaliacoes;
const notaBR = nota.toLocaleString("pt-BR");
const iniciais = (n: string) => n.split(" ").slice(0, 2).map((p) => p[0]).join("");
const cores = ["bg-azul-500", "bg-lingua-500", "bg-amber-500", "bg-emerald-600", "bg-violet-500"];
---

<section id="avaliacoes" class="scroll-mt-24 py-20 sm:py-28">
  <div class="container-site grid items-end gap-10 lg:grid-cols-[1fr_1.4fr]">
    <div data-reveal>
      <span class="eyebrow">⭐ Avaliações no Google</span>
      <h2 class="section-title mt-4">Quem conhece, recomenda</h2>
      <div class="mt-6 flex items-center gap-5">
        <p class="font-display text-7xl font-bold text-azul-900">{notaBR}</p>
        <div>
          <p class="text-2xl tracking-widest text-amber-400" aria-hidden="true">★★★★★</p>
          <p class="font-semibold text-gray-600">{total} avaliações</p>
        </div>
      </div>
    </div>
    <dl class="grid gap-2" data-reveal style="--reveal-delay:120ms">
      {[5, 4, 3, 2, 1].map((n) => {
        const qtd = distribuicao[String(n) as keyof typeof distribuicao];
        return (
          <div class="flex items-center gap-3">
            <dt class="w-10 shrink-0 font-semibold text-gray-600">{n} ★</dt>
            <dd class="h-3 flex-1 overflow-hidden rounded-full bg-azul-100">
              <span class="block h-full rounded-full bg-amber-400" style={`width:${(qtd / total) * 100}%`}></span>
            </dd>
            <dd class="w-10 shrink-0 text-right text-sm text-gray-500">{qtd}</dd>
          </div>
        );
      })}
    </dl>
  </div>

  <div class="relative mt-12">
    <ul class="carrossel container-site flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 [scrollbar-width:none]" aria-label="Depoimentos de clientes">
      {destaques.map((r, i) => (
        <li class="w-[85%] shrink-0 snap-start sm:w-[24rem]" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <figure class="flex h-full flex-col rounded-[1.75rem] bg-white p-7 shadow-lg shadow-azul-900/5 ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl">
            <p class="tracking-widest text-amber-400" aria-label={`${r.nota} estrelas`}>★★★★★</p>
            <blockquote class="mt-3 flex-1 leading-relaxed text-gray-700">“{r.texto}”</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class={`grid size-11 place-items-center rounded-full font-display font-semibold text-white ${cores[i % cores.length]}`} aria-hidden="true">{iniciais(r.autor)}</span>
              <span class="font-semibold">{r.autor}<span class="block text-sm font-normal text-gray-500">Cliente no Google</span></span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <div class="container-site flex items-center justify-between gap-4">
      <a href={loja.googleMaps} class="font-semibold text-azul-700 hover:underline" rel="noopener">Ver todas as avaliações no Google →</a>
      <div class="hidden gap-2 sm:flex">
        <button type="button" class="carrossel-prev grid size-12 place-items-center rounded-full bg-white text-xl shadow ring-1 ring-black/5 hover:bg-azul-50" aria-label="Depoimento anterior">←</button>
        <button type="button" class="carrossel-next grid size-12 place-items-center rounded-full bg-white text-xl shadow ring-1 ring-black/5 hover:bg-azul-50" aria-label="Próximo depoimento">→</button>
      </div>
    </div>
  </div>
</section>

<script>
  const lista = document.querySelector<HTMLElement>(".carrossel");
  if (lista) {
    const passo = () => (lista.querySelector("li")?.clientWidth ?? 300) + 20;
    document.querySelector(".carrossel-prev")?.addEventListener("click", () => lista.scrollBy({ left: -passo(), behavior: "smooth" }));
    document.querySelector(".carrossel-next")?.addEventListener("click", () => lista.scrollBy({ left: passo(), behavior: "smooth" }));
  }
</script>
